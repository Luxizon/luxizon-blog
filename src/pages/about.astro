---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { GITHUB_URL } from '../consts';
---
<BaseLayout title="关于" description="你好，我是 Luxizon，一名学习网络空间安全与计算机技术的大学生。">
  <div class="container page-container about-container">
    <header class="page-heading"><p class="eyebrow">A LITTLE ABOUT ME</p><h1>你好，我是 Luxizon<span class="heading-dot">.</span></h1><p>大学生 / 网络空间安全 / 持续学习中</p></header>
    <div class="about-intro"><div class="about-avatar" aria-hidden="true">L<span>.</span></div><div><h2>保持好奇，把理解变成实践。</h2><p>我正在学习网络空间安全与计算机技术，对代码如何运行、系统如何协作，以及它们的安全边界充满好奇。</p><p>这个博客用来记录学习笔记、开发过程与阶段性的思考。希望在一次次整理和实践中，把零散的知识连接起来。</p><a class="text-link" href={GITHUB_URL} target="_blank" rel="noopener noreferrer"><Icon name="github" size={18} />在 GitHub 找到我 ↗</a></div></div>
    <section class="about-section"><p class="eyebrow">WHAT I'M LEARNING</p><h2>当前学习方向</h2><div class="learning-grid">
      <div><span class="mono">01 / FOUNDATIONS</span><h3>计算机基础</h3><p>C++、数据结构与算法、Linux、操作系统与计算机网络。</p></div>
      <div><span class="mono">02 / SECURITY</span><h3>网络与系统安全</h3><p>Web 安全、CTF 与系统安全，理解问题背后的机制。</p></div>
      <div><span class="mono">03 / EXPLORATION</span><h3>AI 与开发实践</h3><p>探索 AI 应用安全，在个人开发项目中检验想法。</p></div>
    </div></section>
    <section class="about-section"><p class="eyebrow">MY TOOLBOX</p><h2>学习与使用的技术</h2><p class="muted">一份持续扩展的工具箱，而非熟练度清单。</p><div class="toolbox">{['C++', 'Linux', 'Git', 'Astro', 'TypeScript', 'Markdown'].map(tool => <span>{tool}</span>)}</div></section>
    <section class="contact-card"><div><p class="eyebrow">LET'S CONNECT</p><h2>交流，让想法走得更远。</h2><p>可以通过 GitHub 了解我的公开动态。其他联系方式待补充。</p></div><a href={GITHUB_URL} class="button-secondary" target="_blank" rel="noopener noreferrer">GitHub <Icon name="arrow" size={18} /></a></section>
  </div>
</BaseLayout>
